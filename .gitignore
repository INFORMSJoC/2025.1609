# Keep the compact summaries under results/summarized/ and, in this package,
# the raw solver logs of results/T1 and results/T2 next to them, so the
# summaries can be rebuilt from the logs they were produced from. A generated
# command list stays out: the summarizer reads it as the runs the directory is
# supposed to hold, and these logs predate the names it carries.
/results/*
!/results/README.md
!/results/summarized/
/results/summarized/*
!/results/summarized/T1/
/results/summarized/T1/*
!/results/summarized/T1/summary.csv
!/results/summarized/T2/
/results/summarized/T2/*
!/results/summarized/T2/summary.csv
!/results/T1/
!/results/T1/*.out
/results/T1/cmd.sh
!/results/T2/
!/results/T2/*.out
/results/T2/cmd.sh

# The detailed instance-wise results of Tables 3-5 of the paper, which the
# aggregated tables of the paper omit, are shipped too, one file per table
# group, under results/detailed/.
!/results/detailed/
/results/detailed/*
!/results/detailed/README.md
!/results/detailed/*.csv

# Internal coordination, feedback, and historical audits
/admin/
/feedback/
/experiment_log.md
/reports/20*/
/reports/ijoc_revision/


